<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Banderas">
        <activity
            android:name=".Screen.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Banderas"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".Screen.Bandera_Francia"
            android:exported="true"
            android:label="Bandera de Francia"
            android:theme="@style/Theme.Banderas" />
        <activity
            android:name=".Screen.Bandera_Italia"
            android:exported="true"
            android:label="Bandera de Italia"
            android:theme="@style/Theme.Banderas" />
        <activity
            android:name=".Screen.Bandera_Alemania"
            android:exported="true"
            android:label="Bandera de Alemania"
            android:theme="@style/Theme.Banderas" />
        <activity
            android:name=".Screen.Bandera_España"
            android:exported="true"
            android:label="Bandera de España"
            android:theme="@style/Theme.Banderas" />
        <activity
            android:name=".Screen.Bandera_Argentina"
            android:exported="true"
            android:label="Bandera de España"
            android:theme="@style/Theme.Banderas" />
    </application>

</manifest>